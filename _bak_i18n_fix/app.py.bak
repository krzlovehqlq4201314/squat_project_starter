import os, sys
sys.path.append(os.path.dirname(__file__))
import streamlit as st
try:
    from i18n import t, select_language
except Exception:
    import os, sys
    sys.path.insert(0, os.path.dirname(os.path.dirname(__file__)))
    from i18n import t, select_language

# 只能在首页(主入口)调用一次
st.set_page_config(page_title="Squat Checker", layout="wide", initial_sidebar_state="expanded")

# 全局语言选择器
select_language(sidebar=True, key='lang_radio_global')

st.title(t("home_title") + " / Home")
st.write(t("home_tip"))
