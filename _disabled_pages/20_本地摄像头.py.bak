import time, sys
from pathlib import Path
import cv2, numpy as np, streamlit as st, mediapipe as mp

# 允许从 app/ 导入工具
sys.path.append(str(Path(__file__).resolve().parents[1]))
from vis_utils import build_heatmap, colorize_heatmap, overlay_rgba_on_bgr, draw_skeleton_rgba

st.set_page_config(page_title="本地摄像头 - Squat Checker (OpenCV)", layout="wide")
st.title("📷 本地摄像头 - Squat Checker (OpenCV)")

DEVICE_ID = st.sidebar.selectbox("摄像头ID", [0,1,2], index=0)
show_heat = st.sidebar.checkbox("显示热力图", value=False)
show_skel = st.sidebar.checkbox("显示关键线", value=True)
alpha = st.sidebar.slider("热力图透明度", 0.0, 1.0, 0.45, 0.01)
width = st.sidebar.selectbox("分辨率宽", [640, 800, 1280], index=0)
max_fps = st.sidebar.slider("最大FPS", 5, 30, 15)

start = st.button("▶️ 开始")
stop_btn = st.button("⏹ 停止")

ph = st.empty()

if start and not stop_btn:
    cap = cv2.VideoCapture(DEVICE_ID, cv2.CAP_DSHOW)  # Windows 推荐 CAP_DSHOW
    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  width)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

    if not cap.isOpened():
        st.error("无法打开摄像头")
    else:
        pose = mp.solutions.pose.Pose(static_image_mode=False, enable_segmentation=False)
        try:
            last = 0
            while True:
                ok, frame = cap.read()
                if not ok:
                    st.error("读取摄像头失败"); break
                frame = cv2.flip(frame, 1)
                rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                res = pose.process(rgb)

                ih, iw = frame.shape[:2]
                pts = [(0,0)]*33
                if res.pose_landmarks:
                    for i,lm in enumerate(res.pose_landmarks.landmark):
                        if i < 33:
                            pts[i] = (int(lm.x*iw), int(lm.y*ih))

                if show_skel:
                    skel = draw_skeleton_rgba(frame, pts, thickness=3)
                    frame = overlay_rgba_on_bgr(frame, skel, alpha=1.0)

                if show_heat:
                    hmap = build_heatmap(frame.shape[:2], pts, sigma=18, intensity=1.2)
                    heat = colorize_heatmap(hmap)
                    frame = overlay_rgba_on_bgr(frame, heat, alpha=alpha)

                ph.image(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB), use_container_width=True)

                if stop_btn:
                    break
                # 粗略限速
                now = time.time()
                dt = max(1e-3, now - last)
                time.sleep(max(0, 1.0/max_fps - dt))
                last = now
        finally:
            cap.release()
            pose.close()
