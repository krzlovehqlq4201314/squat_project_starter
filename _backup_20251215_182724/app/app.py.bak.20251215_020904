MODEL_DIR = Path("models")
ONNX_PATH = MODEL_DIR / "squat.onnx"
TORCH_PATH = MODEL_DIR / "squat_cls_resnet18.pt"
CLSTXT     = MODEL_DIR / "classes.txt"

IMAGENET_MEAN = np.array([0.485, 0.456, 0.406], dtype=np.float32)
IMAGENET_STD  = np.array([0.229, 0.224, 0.225], dtype=np.float32)

def read_classes(default_nc=2):
    if CLSTXT.exists():
        xs = [x.strip() for x in CLSTXT.read_text(encoding="utf-8").splitlines() if x.strip()]
        if xs: return xs
    return (["correct","incorrect","not_squat"] if default_nc==3 else ["not_squat","squat"])

def preprocess_pil(image_pil, size=224):
    im = image_pil.copy().convert("RGB")
    w, h = im.size
    s = size / min(w, h)
    im = im.resize((int(w*s), int(h*s)))
    w2, h2 = im.size
    l = (w2 - size)//2; t = (h2 - size)//2
    im = im.crop((l, t, l+size, t+size))
    arr = np.asarray(im).astype(np.float32)/255.0
    arr = (arr - IMAGENET_MEAN) / IMAGENET_STD
    arr = arr.transpose(2,0,1)[None,...]  # NCHW
    return arr

def softmax(x):
    x = x - x.max(axis=1, keepdims=True)
    e = np.exp(x)
    return e / e.sum(axis=1, keepdims=True)

@st.cache_resource
def load_infer():
    # 1) ONNX
    if ONNX_PATH.exists():
        import onnxruntime as ort
        sess = ort.InferenceSession(str(ONNX_PATH), providers=["CPUExecutionProvider"])
        in0 = sess.get_inputs()[0]
        in_name = in0.name
        ishape = list(in0.shape)
        is_nhwc = (len(ishape)==4 and ishape[-1]==3)
        # 猜 num_classes
        out0 = sess.get_outputs()[0]
        nc = None
        if isinstance(out0.shape, (list,tuple)) and isinstance(out0.shape[-1], int):
            nc = int(out0.shape[-1])
        classes = read_classes(nc or 2)
        def infer_fn(img_pil):
            x = preprocess_pil(img_pil)
            if is_nhwc: x = x.transpose(0,2,3,1)
            logits = sess.run(None, {in_name: x.astype("float32")})[0]
            probs = softmax(logits)[0]
            return probs, classes
        return "onnx", infer_fn

    # 2) Torch fallback
    try:
        import torch
        from torchvision import models
        if TORCH_PATH.exists():
            m = models.resnet18()
            m.fc = torch.nn.Linear(m.fc.in_features, 2)
            sd = torch.load(TORCH_PATH, map_location="cpu")
            m.load_state_dict(sd if isinstance(sd, dict) else sd["model"], strict=False)
            m.eval()
            classes = read_classes(2)
            def infer_fn(img_pil):
                x = preprocess_pil(img_pil)
                x = torch.from_numpy(x)
                with torch.no_grad():
                    logits = m(x).numpy()
                probs = softmax(logits)[0]
                return probs, classes
            return "torch", infer_fn
    except Exception as e:
        print("Torch fallback disabled:", e)

    # 3) Demo 兜底
    classes = read_classes(2)
    def demo_infer(img_pil):
        arr = np.asarray(img_pil.convert("RGB")).astype(np.float32)/255.0
        br = float(arr.mean())
        return np.array([1.0 - br, br], dtype=np.float32), classes
    return "demo", demo_infer

engine, infer = load_infer()
st.caption(f"Engine: **{engine}** | ONNX: {'OK' if ONNX_PATH.exists() else 'missing'}")

up = st.file_uploader("上传一张图片(JPG/PNG)", type=["jpg","jpeg","png"], key="upload_main")
