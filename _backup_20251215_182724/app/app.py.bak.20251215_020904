probs, classes = infer(im)
idx = int(np.argmax(probs))
conf = float(probs[idx])
st.success(f"{T('prediction')}:**{classes[idx]}** ｜ {T('confidence')}:{conf:.2%}")

df = pd.DataFrame({"class": classes, "prob": probs})
st.altair_chart(
    alt.Chart(df).mark_bar().encode(
        x=alt.X("class:N", sort=None, title=T("class")),
        y=alt.Y("prob:Q", title=T("prob"), scale=alt.Scale(domain=[0,1])),
        tooltip=["class","prob"]
    ).properties(height=220),
    use_container_width=True
)
