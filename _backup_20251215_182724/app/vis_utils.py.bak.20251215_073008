import numpy as np
import cv2

# 关节连线（MediaPipe Pose）
POSE_PAIRS = [
    (11,13),(13,15),(12,14),(14,16),   # 手臂
    (11,12), (23,24), (11,23), (12,24),# 肩/躯干
    (23,25),(25,27),(27,29),           # 左腿
    (24,26),(26,28),(28,30),           # 右腿
    (29,31),(30,32)                    # 脚
]

def _clip_pt(pt, w, h):
    """坐标越界保护 + int 化"""
    x = int(np.clip(pt[0], 0, w - 1))
    y = int(np.clip(pt[1], 0, h - 1))
    return x, y

def build_heatmap(img_shape, points_xy, sigma=16, intensity=1.0):
    """基于关键点生成 0~1 的单通道热力图（float32）——只做数值，不叠色"""
    h, w = int(img_shape[0]), int(img_shape[1])
    heat = np.zeros((h, w), np.float32)
    if not points_xy:
        return heat

    # 高斯核：必须为奇数且>0，否则 OpenCV 可能触发断言
    k = max(3, 2 * int(3 * sigma) + 1)
    for x, y in points_xy:
        if x is None or y is None or np.isnan(x) or np.isnan(y):
            continue
        cx, cy = _clip_pt((x, y), w, h)
        heat[cy, cx] = 1.0

    heat = cv2.GaussianBlur(heat, (k, k), sigmaX=sigma, sigmaY=sigma, borderType=cv2.BORDER_DEFAULT)
    heat = np.clip(heat * float(intensity), 0.0, 1.0)
    return heat

def colorize_heatmap(heat, colormap=cv2.COLORMAP_JET):
    """把 0~1 热力图转 BGR 彩图（uint8）以便叠加"""
    if heat.ndim == 3:
        heat = cv2.cvtColor(heat, cv2.COLOR_BGR2GRAY)
    hm8 = np.clip(heat * 255.0, 0, 255).astype(np.uint8)
    return cv2.applyColorMap(hm8, colormap)

def overlay_img(base_bgr, overlay_bgr, alpha=0.4):
    """把 overlay(BGR) 以 alpha 叠到 base(BGR) 上，自动对齐尺寸与 dtype"""
    if base_bgr is None or overlay_bgr is None:
        return base_bgr
    if overlay_bgr.ndim == 2:
        overlay_bgr = cv2.cvtColor(overlay_bgr, cv2.COLOR_GRAY2BGR)
    if overlay_bgr.shape[:2] != base_bgr.shape[:2]:
        overlay_bgr = cv2.resize(overlay_bgr, (base_bgr.shape[1], base_bgr.shape[0]), interpolation=cv2.INTER_LINEAR)
    if overlay_bgr.dtype != np.uint8:
        overlay_bgr = np.clip(overlay_bgr, 0, 255).astype(np.uint8)
    return cv2.addWeighted(base_bgr, 1.0, overlay_bgr, float(alpha), 0.0)

def draw_pose_lines(img_bgr, points_xy, pairs=POSE_PAIRS, color=(0,255,0), thickness=2):
    """按 pairs 在 BGR 图上画关键线，坐标越界保护"""
    if img_bgr is None or not points_xy:
        return img_bgr
    h, w = img_bgr.shape[:2]
    pts = []
    for p in points_xy:
        if p is None or len(p) < 2 or np.any(np.isnan(p)):
            pts.append(None)
        else:
            pts.append(_clip_pt(p, w, h))

    for i, j in pairs:
        if i < len(pts) and j < len(pts) and pts[i] and pts[j]:
            cv2.line(img_bgr, pts[i], pts[j], color, thickness, cv2.LINE_AA)
    return img_bgr
