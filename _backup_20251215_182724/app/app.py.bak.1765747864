import os, io
import numpy as np
import pandas as pd
import cv2
from PIL import Image
import streamlit as st
import mediapipe as mp

# ---------------- UI & i18n ----------------
st.set_page_config(page_title="Squat Checker (MediaPipe)", layout="wide")

LANGS = {
    "zh": {
        "title": "深蹲动作识别（MediaPipe 版）",
        "lang": "语言",
        "zh": "中文", "en": "English", "ko": "한국어",
        "uploader": "单张图片上传（JPG/PNG）",
        "pred": "预测：{label} | 置信度：{p:.2f}%",
        "tip_good": "看起来动作不错，保持住！",
        "tip_bad": "建议下蹲更深一点，膝盖方向对齐脚尖，并保持脊柱中立。",
        "th": "判定为 squat 的阈值",
        "feat": "动作指导",
        "bar_title": "概率分布",
        "no_pose": "没有检测到人体姿态，请换一张更清晰/完整的人像侧面图。"
    },
    "en": {
        "title": "Squat Detector (MediaPipe)",
        "lang": "Language",
        "zh": "中文", "en": "English", "ko": "한국어",
        "uploader": "Upload an image (JPG/PNG)",
        "pred": "Prediction: {label} | Confidence: {p:.2f}%",
        "tip_good": "Looks good! Keep the posture.",
        "tip_bad": "Try to go deeper, track knees over toes, and keep a neutral spine.",
        "th": "Threshold for classifying as squat",
        "feat": "Coaching tip",
        "bar_title": "Probabilities",
        "no_pose": "No pose detected. Use a clearer side-view human image."
    },
    "ko": {
        "title": "스쿼트 동작 감지 (MediaPipe)",
        "lang": "언어",
        "zh": "中文", "en": "English", "ko": "한국어",
        "uploader": "이미지 업로드 (JPG/PNG)",
        "pred": "예측: {label} | 신뢰도: {p:.2f}%",
        "tip_good": "자세가 좋아 보여요. 유지하세요!",
        "tip_bad": "조금 더 깊게 앉고, 무릎은 발끝 방향으로 유지하며, 척추 중립을 지키세요.",
        "th": "스쿼트로 분류할 임계값",
        "feat": "동작 코칭",
        "bar_title": "확률 분포",
        "no_pose": "포즈를 감지하지 못했습니다. 더 선명한 측면 전신 이미지를 사용하세요."
    }
