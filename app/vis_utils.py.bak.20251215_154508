import cv2
import numpy as np

POSE_PAIRS = [
    (11,13),(13,15),
    (12,14),(14,16),
    (11,12),
    (23,24),
    (11,23),(12,24),
    (23,25),(25,27),(27,29),(29,31),
    (24,26),(26,28),(28,30),(30,32),
]

def _valid_xy(p):
    if p is None: return False
    x, y = p
    if x is None or y is None: return False
    if isinstance(x, float) and (np.isnan(x) or np.isinf(x)): return False
    if isinstance(y, float) and (np.isnan(y) or np.isinf(y)): return False
    return True

def build_heatmap(img_shape, points_xy, sigma=16, intensity=1.0):
    H, W = int(img_shape[0]), int(img_shape[1])
    heat = np.zeros((H, W), np.float32)
    if points_xy is None:
        return heat
    r = max(1, int(round(sigma/2)))
    for p in points_xy:
        if not _valid_xy(p): 
            continue
        x, y = int(round(p[0])), int(round(p[1]))
        if 0 <= x < W and 0 <= y < H:
            cv2.circle(heat, (x, y), r, float(intensity), -1, lineType=cv2.LINE_AA)
    k = int(6 * sigma + 1)
    if k % 2 == 0: k += 1
    heat = cv2.GaussianBlur(heat, (k, k), sigmaX=sigma, sigmaY=sigma, borderType=cv2.BORDER_REPLICATE)
    if heat.max() > 0: heat = heat / float(heat.max())
    return heat.astype(np.float32)

def colorize_heatmap(heat, colormap=None, alpha_scale=0.45):
    h8 = np.clip(heat * 255.0, 0, 255).astype(np.uint8)
    if colormap is None:
        colormap = getattr(cv2, "COLORMAP_TURBO", cv2.COLORMAP_JET)
    bgr = cv2.applyColorMap(h8, colormap)
    a = np.clip(heat * 255.0 * float(alpha_scale), 0, 255).astype(np.uint8)
    bgra = np.dstack([bgr, a])
    return bgra

def overlay_rgba_on_bgr(bgr, rgba):
    if rgba.shape[2] == 3:
        alpha = np.full(bgr.shape[:2], 128, dtype=np.uint8)
        rgba = np.dstack([rgba, alpha])
    overlay = rgba[:, :, :3].astype(np.float32)
    alpha = (rgba[:, :, 3].astype(np.float32) / 255.0)[..., None]
    base = bgr.astype(np.float32)
    out = overlay * alpha + base * (1.0 - alpha)
    return np.clip(out, 0, 255).astype(np.uint8)

def overlay_img(bgr, rgba, **kwargs):
    return overlay_rgba_on_bgr(bgr, rgba)

# ================== 关键修复：确保传入 cv2.line 的数组是 C 连续的 ==================
def draw_skeleton_rgba(frame, pts, thickness=2, line_color=(0,255,255)):
    """
    返回 (H,W,4) uint8 的 RGBA 叠加层。使用独立 canvas/alpha（C 连续），避免 cv2.line 报错。
    """
    H, W = frame.shape[:2]

    # 独立、C 连续的画布
    canvas = np.zeros((H, W), dtype=np.uint8)      # 先画到单通道，再着色，避免通道切片造成的非连续视图
    alpha  = np.zeros((H, W), dtype=np.uint8)

    def _int_xy(p): return (int(round(p[0])), int(round(p[1])))

    for i, j in POSE_PAIRS:
        if i >= len(pts) or j >= len(pts): 
            continue
        pi, pj = pts[i], pts[j]
        if not (_valid_xy(pi) and _valid_xy(pj)):
            continue
        p1, p2 = _int_xy(pi), _int_xy(pj)
        cv2.line(canvas, p1, p2, 255, thickness, cv2.LINE_AA)
        cv2.line(alpha,  p1, p2, 255, thickness, cv2.LINE_AA)

    # 关键点
    for p in pts:
        if not _valid_xy(p): 
            continue
        cp = _int_xy(p)
        cv2.circle(canvas, cp, max(2, thickness), 255, -1, cv2.LINE_AA)
        cv2.circle(alpha,  cp, max(2, thickness), 255, -1, cv2.LINE_AA)

    # 将单通道 canvas 着色为 BGR
    bgr = cv2.cvtColor(canvas, cv2.COLOR_GRAY2BGR)
    color = np.array(line_color, dtype=np.uint8)[None, None, :]
    bgr = (canvas[..., None] * (color / 255.0)).astype(np.uint8)

    rgba = np.dstack([bgr, alpha])
    return rgba

def draw_pose_lines(bgr, pts, thickness=2, color=(0,255,255)):
    out = np.ascontiguousarray(bgr.copy())
    def _int_xy(p): return (int(round(p[0])), int(round(p[1])))
    for i, j in POSE_PAIRS:
        if i >= len(pts) or j >= len(pts): 
            continue
        pi, pj = pts[i], pts[j]
        if not (_valid_xy(pi) and _valid_xy(pj)):
            continue
        cv2.line(out, _int_xy(pi), _int_xy(pj), color, thickness, cv2.LINE_AA)
    return out
# --- patched overlay (last definition wins) ---
import cv2, numpy as np
def overlay_rgba_on_bgr(bgr, rgba, alpha: float = 1.0):
    """Overlay an RGBA/RGB image on top of a BGR frame with alpha in [0,1]."""
    if bgr is None or rgba is None:
        return bgr
    # 尺寸对齐
    if rgba.shape[:2] != bgr.shape[:2]:
        rgba = cv2.resize(rgba, (bgr.shape[1], bgr.shape[0]))
    # 拆分通道
    if rgba.shape[2] == 4:
        rgb = rgba[..., :3]
        a = rgba[..., 3:4].astype(np.float32) / 255.0
        a = a * float(alpha)
    else:
        rgb = rgba
        a = np.full(bgr.shape[:2] + (1,), float(alpha), dtype=np.float32)
    # 颜色空间与混合
    bgr_f = bgr.astype(np.float32)
    rgb_bgr = cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR).astype(np.float32)
    out = (1.0 - a) * bgr_f + a * rgb_bgr
    return out.clip(0, 255).astype(np.uint8)
# --- end patch ---
# --- appended safe utils (idempotent) ---
import numpy as _np, cv2 as _cv2

def overlay_rgba_on_bgr(_bgr, _rgba, alpha=0.45):
    if _rgba is None: 
        return _bgr
    _b = _bgr.astype(_np.float32)
    if _rgba.shape[-1] == 4:
        _rgb = _rgba[...,:3].astype(_np.float32)
        _a   = (_rgba[...,3:4].astype(_np.float32)/255.0) * float(alpha)
        _out = _b*(1.0-_a) + _rgb*_a
    else:
        _rgb = _rgba.astype(_np.float32)
        _a   = float(alpha)
        _out = _b*(1.0-_a) + _rgb*_a
    return _np.clip(_out, 0, 255).astype(_np.uint8)

def draw_skeleton_rgba(frame, pts, thickness=2):
    h, w = frame.shape[:2]
    rgba = _np.zeros((h, w, 4), dtype=_np.uint8)
    color = (255, 255, 0, 255)
    pairs = [(11,13),(13,15),(12,14),(14,16),
             (23,25),(25,27),(24,26),(26,28),
             (23,24),(11,12),(23,11),(24,12)]
    p = _np.array(pts, dtype=_np.float32)
    for i,j in pairs:
        if i < len(p) and j < len(p) and p[i].sum()>0 and p[j].sum()>0:
            _cv2.line(rgba, (int(p[i][0]), int(p[i][1])), (int(p[j][0]), int(p[j][1])), color, thickness)
    return rgba
