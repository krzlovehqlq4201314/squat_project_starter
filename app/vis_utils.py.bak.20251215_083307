
import numpy as np
import cv2

# 关节连线（Mediapipe Pose 的常用边）
POSE_PAIRS = [
    (11,13),(13,15),(12,14),(14,16),          # 手臂
    (11,12),                                   # 肩
    (23,24),(11,23),(12,24),                   # 躯干
    (23,25),(25,27),(24,26),(26,28),           # 大腿
    (27,29),(29,31),(28,30),(30,32),           # 小腿
]

def _default_cmap_lut(n=256):
    """自带一个简洁的 LUT（避免依赖 cv2 内置常量）。蓝->青->黄->红 渐变。"""
    x = np.linspace(0, 1, n, dtype=np.float32)
    r = np.clip(1.5 * x - 0.2, 0, 1)
    g = np.clip(1.5 * (1 - np.abs(2*x-1)), 0, 1)
    b = np.clip(1.3 * (1 - x) + 0.1, 0, 1)
    lut = np.stack([b, g, r], axis=1)  # BGR
    return (lut * 255).astype(np.uint8)

def colorize_heatmap(heat: np.ndarray, colormap: int | None = None) -> np.ndarray:
    """
    将 [0,1] 的单通道热力图转为 BGR 伪彩色。
    优先用 cv2.applyColorMap；若没有 COLORMAP 常量，则回退到自带 LUT。
    """
    if heat.ndim == 3:
        heat = cv2.cvtColor(heat, cv2.COLOR_BGR2GRAY)
    heat_u8 = np.clip(heat, 0, 1)
    # 归一化到 [0,255]
    heat_u8 = (heat_u8 * 255 + 0.5).astype(np.uint8)

    # 优先尝试 OpenCV 内置
    try:
        if colormap is None:
            colormap = getattr(cv2, 'COLORMAP_TURBO', None)
            if colormap is None:
                colormap = getattr(cv2, 'COLORMAP_JET', None)
        if colormap is not None:
            return cv2.applyColorMap(heat_u8, colormap)
    except Exception:
        pass

    # 回退：使用自带 LUT
    lut = _default_cmap_lut(256)   # [256,3] BGR
    return lut[heat_u8]

def build_heatmap(img_shape, points_xy, sigma=16, intensity=1.0):
    """
    根据关键点列表生成单通道热力图（值域 0~1）。
    points_xy: [(x,y,score), ...] 或 [(x,y), ...]；score 可选。
    """
    H, W = img_shape[:2]
    heat = np.zeros((H, W), dtype=np.float32)
    if points_xy is None:
        return heat
    # 预先生成高斯核距离项
    yy, xx = np.mgrid[0:H, 0:W]
    for p in points_xy:
        if p is None:
            continue
        x, y = float(p[0]), float(p[1])
        conf = float(p[2]) if len(p) >= 3 else 1.0
        if not (0 <= x < W and 0 <= y < H):
            continue
        g = np.exp(-((xx-x)**2 + (yy-y)**2) / (2*sigma*sigma)) * (conf * intensity)
        heat = np.maximum(heat, g)
    heat = np.clip(heat, 0, 1)
    return heat

def draw_skeleton_rgba(img_shape, points_xy, edges=POSE_PAIRS, color=(0, 255, 255, 180), thickness=3):
    """
    仅根据关键点画一张 RGBA 的骨架层（不直接画到原图上，方便叠加/隐藏）。
    img_shape: (H,W,3) 或 (H,W)
    """
    H, W = img_shape[:2]
    rgba = np.zeros((H, W, 4), dtype=np.uint8)
    if points_xy is None:
        return rgba
    def p_ok(idx):
        if idx < 0 or idx >= len(points_xy): return False
        p = points_xy[idx]
        if p is None: return False
        x, y = p[:2]
        return (0 <= x < W and 0 <= y < H)
    for a, b in edges:
        if p_ok(a) and p_ok(b):
            ax, ay = map(int, points_xy[a][:2])
            bx, by = map(int, points_xy[b][:2])
            cv2.line(rgba, (ax, ay), (bx, by), color, thickness, cv2.LINE_AA)
    return rgba

def overlay_rgba_on_bgr(bgr: np.ndarray, rgba: np.ndarray) -> np.ndarray:
    """
    将 RGBA 图层以 alpha 方式叠加到 BGR 底图上。
    """
    if rgba is None or rgba.size == 0:
        return bgr
    if bgr.shape[:2] != rgba.shape[:2]:
        rgba = cv2.resize(rgba, (bgr.shape[1], bgr.shape[0]), interpolation=cv2.INTER_LINEAR)
    # 分离通道
    rgb, a = rgba[..., :3].astype(np.float32), rgba[..., 3:4].astype(np.float32) / 255.0
    base = bgr.astype(np.float32)
    out = base * (1 - a) + rgb * a
    return out.clip(0, 255).astype(np.uint8)


def draw_skeleton_rgba(frame, pts, thickness=2):
    """
    在透明 RGBA 画布上画骨架；对输入做强制整型、容错处理，避免 numpy 标量/数组引发报错。
    frame: BGR np.uint8 (H,W,3)
    pts:   (N,2) 或 (1,N,2) 关键点坐标
    """
    import numpy as np, cv2
    # 防御：frame 不合法时给一个 1x1 透明图，避免 NoneType 等崩溃
    if frame is None or not hasattr(frame, 'shape') or len(frame.shape) < 2:
        return np.zeros((1, 1, 4), dtype=np.uint8)

    H0, W0 = frame.shape[:2]
    # ——关键：把高宽强制成「真正的 Python int」
    H = int(H0)
    W = int(W0)

    rgba = np.zeros((H, W, 4), dtype=np.uint8)
    th = int(thickness) if thickness is not None else 2

    # 关键点容错与规整
    if pts is None:
        return rgba
    import numpy as np
    pts = np.asarray(pts)
    if pts.size == 0:
        return rgba
    if pts.ndim == 3:                      # 兼容 (1,N,2)
        pts = pts.reshape(-1, 2)
    elif pts.ndim == 1:                    # 兼容一维输入
        pts = pts.reshape(-1, 2)
    pts = pts.astype(np.float32)

    for i, j in POSE_PAIRS:
        if i < len(pts) and j < len(pts):
            xi, yi = pts[i]
            xj, yj = pts[j]
            if not (np.isnan(xi) or np.isnan(yi) or np.isnan(xj) or np.isnan(yj)):
                cv2.line(rgba[..., :3], (int(xi), int(yi)), (int(xj), int(yj)),
                         (0, 255, 255), th, lineType=cv2.LINE_AA)
                cv2.circle(rgba[..., :3], (int(xi), int(yi)),
                           max(1, th+1), (0,128,255), -1, lineType=cv2.LINE_AA)
                cv2.circle(rgba[..., :3], (int(xj), int(yj)),
                           max(1, th+1), (0,128,255), -1, lineType=cv2.LINE_AA)

    rgba[..., 3] = (rgba[..., :3].max(axis=2) > 0).astype(np.uint8) * 160
    return rgba


def overlay_rgba_on_bgr(bgr, rgba, alpha=None):
    """把 RGBA 透明层叠加到 BGR 图像上；分辨率不一致时自动 resize。"""
    import numpy as np, cv2
    H, W = bgr.shape[:2]
    if rgba.shape[:2] != (H, W):
        rgba = cv2.resize(rgba, (W, H), interpolation=cv2.INTER_LINEAR)

    rgb = rgba[..., :3].astype(np.float32)
    a = rgba[..., 3:4].astype(np.float32) / 255.0
    if alpha is not None:
        a = np.clip(a * float(alpha), 0, 1)
    out = bgr.astype(np.float32) * (1.0 - a) + rgb * a
    return out.astype(np.uint8)
