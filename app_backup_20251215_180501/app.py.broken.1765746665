def T(key, lang=None):
    if lang is None:
        lang = st.session_state.get("lang", "zh")
    return LANG_TEXTS.get(lang, {}).get(key, key)

st.set_page_config(page_title="Squat Inspector", layout="wide")

if "lang" not in st.session_state:
    st.session_state["lang"] = "zh"

lang_display = {
    "zh": LANG_TEXTS["zh"]["lang_zh"],
    "en": LANG_TEXTS["en"]["lang_en"],
    "ko": LANG_TEXTS["ko"]["lang_ko"],
}
lang_order = ["zh", "en", "ko"]
default_idx = lang_order.index(st.session_state["lang"]) if st.session_state["lang"] in lang_order else 0
sel = st.sidebar.radio(
    label=LANG_TEXTS[st.session_state["lang"]]["lang_label"],
    options=[lang_display[c] for c in lang_order],
    index=default_idx,
)
for code in lang_order:
    if lang_display[code] == sel:
        st.session_state["lang"] = code
        break

# ---- calibration controls ----
swap_order = st.sidebar.checkbox(T("swap_label"), value=False, help=T("note_swap"))
thresh = st.sidebar.slider(T("thresh_label"), 0.30, 0.70, 0.50, 0.01)

BASE_CLASSES = ["not_squat", "squat"]  # base interpretation
VIEW_CLASSES = BASE_CLASSES[::-1] if swap_order else BASE_CLASSES

def softmax(x):
    x = np.asarray(x, dtype=np.float32)
    x = x - np.max(x)
    e = np.exp(x)
    s = e / np.sum(e)
    return s

_session = None
def get_session():
    global _session
    if _session is not None:
        return _session
    model_path = os.path.join("models", "squat.onnx")
    if ort is None or not os.path.exists(model_path):
        return None
    try:
        _session = ort.InferenceSession(model_path, providers=["CPUExecutionProvider"])
        return _session
    except Exception:
        return None

def predict_with_onnx(img):
    sess = get_session()
    if sess is None:
        return None
# try:  # auto-removed
        x = img.convert("RGB").resize((224, 224))
        arr = np.asarray(x, dtype=np.float32) / 255.0
        arr = np.transpose(arr, (2, 0, 1))
        inp = np.expand_dims(arr, 0)
        inp_name = sess.get_inputs()[0].name
        out_name = sess.get_outputs()[0].name
        out = sess.run([out_name], {inp_name: inp})[0]
        out = np.squeeze(out)
        if out.ndim == 0:
            out = np.array([float(out), 1.0 - float(out)], dtype=np.float32)
        probs = softmax(out)

# —— 概率+膝角 融合兜底 ——
raw_th = st.session_state.get("squat_threshold", st.session_state.get("threshold", 0.5))
try:
    _squat_th = float(raw_th)
except Exception:
    _squat_th = 0.5
except Exception:
    _squat_th = 0.5
try:
    pred_label, confidence, knee_tip = apply_knee_angle_fusion(
        img, probs, CLASS_NAMES, pred_label, confidence, _squat_th
    )
    if knee_tip:
        st.info(knee_tip)
except Exception as _e:
    try:
        st.debug(f"fusion skipped: {_e}")
    except Exception:
        pass
        # 只取前两个作为 [not_squat, squat] 的基准序
        if probs.shape[0] == 1:
            probs = np.array([float(probs[0]), 1.0 - float(probs[0])], dtype=np.float32)
        elif probs.shape[0] >= 2:
            probs = np.array([probs[0], probs[1]], dtype=np.float32)
        else:
            probs = np.array([0.5, 0.5], dtype=np.float32)
        probs = probs / np.sum(probs)
        # 若用户勾选了“顺序换位”，把概率对调，使之与 VIEW_CLASSES 对齐
        if swap_order:
            probs = probs[::-1]
        return probs
    except Exception:
        return None

def predict_fallback(img):
    g = img.convert("L").resize((64, 64))
    stdv = np.asarray(g, dtype=np.float32).std() / 255.0
    p_squat = min(0.9, max(0.1, 0.2 + 0.9 * stdv))
    p_not = 1.0 - p_squat
    probs = np.array([p_not, p_squat], dtype=np.float32)  # [not_squat, squat]
    if swap_order:
        probs = probs[::-1]  # 与 VIEW_CLASSES 对齐
    return probs

def predict(img):
    probs = predict_with_onnx(img)
    if probs is None:
        probs = predict_fallback(img)
    probs = probs / np.sum(probs)

    # 用阈值来决定最终标签：squat 概率超过阈值 => squat，否则 not_squat
    squat_idx = VIEW_CLASSES.index("squat")
    p_squat = float(probs[squat_idx])
    label = "squat" if p_squat >= thresh else "not_squat"
    conf = p_squat if label == "squat" else float(probs[1 - squat_idx])
    return label, conf, probs

st.markdown(f"# {T('app_title')}")

up = st.file_uploader(T("upload_label"), type=["jpg", "jpeg", "png"])
st.caption(T("limit"))

if up is not None:
    img = Image.open(up)
    st.image(img, caption=f"{T('uploaded')}: {up.name}")

    label, conf, probs = predict(img)

    st.success(f"{T('prediction')}: {label} | {T('confidence')}: {conf:.2%}")

    if label == "not_squat":
        with st.container(border=True):
            st.markdown(f"**{T('tip_bad_title')}**")
            st.write(T("tip_bad_body"))
    else:
        st.info(T("tip_good"))

    df = pd.DataFrame({"class": VIEW_CLASSES, "prob": probs})
    chart = (
        alt.Chart(df)
        .mark_bar()
        .encode(
            x=alt.X("class:N", sort=None, title="class"),
            y=alt.Y("prob:Q", scale=alt.Scale(domain=[0, 1]), title="prob"),
            tooltip=[alt.Tooltip("class:N"), alt.Tooltip("prob:Q", format=".2%")],
        )
        .properties(height=260)
    )
    st.altair_chart(chart, use_container_width=True)

# --- Knee-angle helper (MediaPipe) ---
def estimate_knee_angles_bgr(bgr_img):
    """
    Return (right_knee_angle, left_knee_angle) in degrees, or None if undetected.
    Angles are Hip-Knee-Ankle. Larger = straighter. ~180° is straight leg.
    """
    try:
        import mediapipe as mp
        mp_pose = mp.solutions.pose
    except Exception:
        return None  # mediapipe 未安装或加载失败时，跳过姿态校验

    h, w = bgr_img.shape[:2]
    with mp_pose.Pose(static_image_mode=True) as pose:
        rgb = bgr_img[:, :, ::-1]  # BGR -> RGB
        res = pose.process(rgb)
        if not res.pose_landmarks:
            return None

        lm = res.pose_landmarks.landmark

        def pt(i):
            return (lm[i].x * w, lm[i].y * h)

        import math
        def angle(a, b, c):
            ax, ay = a; bx, by = b; cx, cy = c
            v1 = (ax-bx, ay-by); v2 = (cx-bx, cy-by)
            dot = v1[0]*v2[0] + v1[1]*v2[1]
            n1 = math.hypot(*v1); n2 = math.hypot(*v2)
            if n1 * n2 == 0:
                return None
            cosv = max(-1.0, min(1.0, dot/(n1*n2)))
            return math.degrees(math.acos(cosv))

        # Hip (24/23) - Knee (26/25) - Ankle (28/27)
        right = angle(pt(24), pt(26), pt(28))
        left  = angle(pt(23), pt(25), pt(27))
        return right, left
