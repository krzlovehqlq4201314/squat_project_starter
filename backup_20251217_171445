from typing import Optional, Tuple
import numpy as np
import cv2
from ultralytics import YOLO

# ===== 可调参数 =====
KNEE_ANGLE_THRESH = 100   # 膝角<=100° 视为到位（更宽松）
TORSO_LEAN_MAX    = 28    # 躯干前倾最大允许角
KP_CONF_TH        = 0.35  # 关键点最小置信度
IMG_SIZE          = 640   # 推理分辨率
# ====================

# COCO 索引（YOLOv8 pose）
NOSE=0; LEYE=1; REYE=2; LEAR=3; REAR=4
LSHO=5; RSHO=6; LELB=7; RELB=8; LWR=9; RWR=10
LHIP=11; RHIP=12; LKNE=13; RKNE=14; LANK=15; RANK=16

def load_model(weights: str = "yolov8n-pose.pt"):
    model = YOLO(weights)
    model.overrides["imgsz"] = IMG_SIZE
    model.overrides["verbose"] = False
    return model

def _pt(kxy: np.ndarray, kconf: np.ndarray, idx: int) -> Optional[Tuple[float,float]]:
    return (float(kxy[idx,0]), float(kxy[idx,1])) if (kconf is not None and kconf[idx] is not None and kconf[idx] >= KP_CONF_TH) else None

def _angle(a, b, c) -> Optional[float]:
    # ∠ABC（b为顶点）
    if a is None or b is None or c is None:
        return None
    a = np.array(a); b = np.array(b); c = np.array(c)
    ba = a - b; bc = c - b
    nba = np.linalg.norm(ba); nbc = np.linalg.norm(bc)
    if nba < 1e-6 or nbc < 1e-6:
        return None
    cosang = np.clip(np.dot(ba, bc) / (nba * nbc), -1.0, 1.0)
    return float(np.degrees(np.arccos(cosang)))

def _draw_kps(img, kxy, kconf):
    sk = [(LSHO, RSHO), (LSHO, LHIP), (RSHO, RHIP),
          (LHIP, LKNE), (LKNE, LANK), (RHIP, RKNE), (RKNE, RANK)]
    for i in range(kxy.shape[0]):
        if kconf[i] is not None and kconf[i] >= KP_CONF_TH:
            cv2.circle(img, (int(kxy[i,0]), int(kxy[i,1])), 3, (0,255,255), -1)
    for a,b in sk:
        if kconf[a] is not None and kconf[a] >= KP_CONF_TH and kconf[b] is not None and kconf[b] >= KP_CONF_TH:
            cv2.line(img, (int(kxy[a,0]), int(kxy[a,1])), (int(kxy[b,0]), int(kxy[b,1])), (0,255,0), 2)

def analyze(img_bgr: np.ndarray, model, draw_lines=True, draw_heat=False):
    """
    返回 (可视化图像BGR, 文本消息)
    规则：
      - 必须检测到髋/膝/踝（任一侧完整且置信度达标），否则不判；
      - depth_ok = (膝角<=阈值) OR (髋y>膝y)  二选一即可；
      - torso_ok = 躯干前倾<=阈值；
      - SQUAT = depth_ok AND torso_ok。
    """
    res = model.predict(img_bgr, imgsz=IMG_SIZE, verbose=False)[0]
    if res.keypoints is None or res.keypoints.xy is None or len(res.keypoints.xy) == 0:
        return img_bgr, "[NO PERSON] 画面里没有检测到人体"

    # 取最可信的人
    person_idx = int(np.argmax(res.boxes.conf.cpu().numpy())) if res.boxes is not None else 0
    kxy   = res.keypoints.xy[person_idx].cpu().numpy()
    kconf = res.keypoints.conf[person_idx].cpu().numpy()

    # 取关键点（带置信度门槛）
    Lhip = _pt(kxy, kconf, LHIP); Lknee = _pt(kxy, kconf, LKNE); Lank = _pt(kxy, kconf, LANK)
    Rhip = _pt(kxy, kconf, RHIP); Rknee = _pt(kxy, kconf, RKNE); Rank = _pt(kxy, kconf, RANK)
    Lsho = _pt(kxy, kconf, LSHO); Rsho = _pt(kxy, kconf, RSHO)

    legs_ok_left  = (Lhip is not None and Lknee is not None and Lank is not None)
    legs_ok_right = (Rhip is not None and Rknee is not None and Rank is not None)
    legs_ok = legs_ok_left or legs_ok_right

    vis = img_bgr.copy()
    if draw_lines:
        _draw_kps(vis, kxy, kconf)

    if not legs_ok:
        return vis, "NOT SQUAT ❌ | 请把**全身（尤其是髋/膝/踝）**放进画面，再开始检测"

    # 膝角：取两侧最小值作为深度参考
    kneeL = _angle(Lhip, Lknee, Lank) if legs_ok_left else None
    kneeR = _angle(Rhip, Rknee, Rank) if legs_ok_right else None
    cand = [x for x in [kneeL, kneeR] if x is not None]
    knee_angle = min(cand) if cand else None

    # 髋是否低于膝（y越大越低）
    hip_below_knee = False
    if legs_ok_left and Lhip and Lknee: hip_below_knee |= (Lhip[1] > Lknee[1] + 2)
    if legs_ok_right and Rhip and Rknee: hip_below_knee |= (Rhip[1] > Rknee[1] + 2)

    # 躯干前倾角（肩-髋相对竖直）
    torso_ok = True
    if Lsho and Rsho and (Lhip or Rhip):
        sho_c = ((Lsho[0]+Rsho[0])/2, (Lsho[1]+Rsho[1])/2)
        hip_c = ((Lhip[0]+Rhip[0])/2, (Lhip[1]+Rhip[1])/2) if (Lhip and Rhip) else (Lhip or Rhip)
        if hip_c:
            v = np.array(hip_c) - np.array(sho_c)
            vertical = np.array([0, 1.0])
            cosang = np.clip(np.dot(v, vertical) / (np.linalg.norm(v)*np.linalg.norm(vertical)), -1, 1)
            lean = float(np.degrees(np.arccos(cosang)))
            torso_ok = (lean <= TORSO_LEAN_MAX)

    depth_ok = False
    tips = []
    if knee_angle is not None and knee_angle <= KNEE_ANGLE_THRESH:
        depth_ok = True
    if hip_below_knee:
        depth_ok = True
    if knee_angle is None:
        tips.append("关键点不稳定，移动到光线更好的位置")
    if not depth_ok:
        if knee_angle is not None:
            tips.append(f"膝角 {int(round(knee_angle))}° → 再下沉一点（让髋低于膝）")
        else:
            tips.append("请下蹲更深（让髋低于膝）")
    if not torso_ok:
        tips.append(f"躯干前倾过大（>{TORSO_LEAN_MAX}°），抬胸/收紧核心")

    status = "SQUAT ✅" if (depth_ok and torso_ok) else "NOT SQUAT ❌"
    parts = []
    if knee_angle is not None: parts.append(f"Knee {int(round(knee_angle))}°")
    if hip_below_knee: parts.append("Hip below knee")
    msg = f"{status} | " + " | ".join(parts + tips) if (parts or tips) else status
    return vis, msg
